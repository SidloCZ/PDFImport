{
  "manifest_version": 3,
  "name": "PDF to AI Chat Fast Import",
  "version": "1.0.0",
  "description": "Automaticky a bleskově vloží otevřený PDF dokument do Google Gemini chatu bez nutnosti ručního stahování.",
  "author": "Antigravity",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Odeslat PDF do Gemini (Alt+G)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "send-pdf-to-gemini": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Odeslat aktuální PDF dokument do chatu Gemini"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_gemini.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}