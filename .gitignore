# ============================================================
# Bezpečnostní .gitignore pro PDF to AI Chat Extension
# Zabraňuje nechtěnému nahrání citlivých dat, klíčů a souborů
# ============================================================

# 1. Citlivé osobní / stažené dokumenty (aby se omylem nenahrálo testovací PDF)
*.pdf
*.PDF
*.epub
*.doc
*.docx
test_files/
downloads/
samples/

# 2. Privátní klíče a certifikáty rozšíření (Chrome Pack Extension vygeneruje .pem)
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
key.pem
private.key

# 3. API klíče, hesla, tokeny a environment proměnné
.env
.env.*
!.env.example
*.env
secrets.json
credentials.json
auth.json
token.json
api_keys.json
local.settings.json
config.local.json

# 4. Uživatelská data prohlížeče, cookies a session soubory
cookies.txt
*.cookie
user-data-dir/
browser_profile/
storage_dump/

# 5. Distribuční balíčky a archivy
*.crx
*.xpi
*.zip
*.tar.gz
dist/
build/
out/

# 6. Logy, debug dumpy a dočasné soubory
*.log
npm-debug.log*
yarn-debug.log*
debug/
debug-extension/
debug logs/
debug_logs/
debug_output/
*.tmp
*.bak
*~
*.swp
*.swo

# 7. Vývojářské a IDE složky
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 8. Systémové soubory OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 9. Node dependencies a cache
node_modules/
.npm
.eslintcache

# 10. AI IDE / Antigravity metadata a scratch složky
.gemini/
.agents/
scratch/

# 11. Python cache
__pycache__/
*.py[cod]
*$py.class

